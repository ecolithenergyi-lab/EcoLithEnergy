NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/ecolith_energy
USE_MEMORY_DB_FALLBACK=true

# Generate a unique random value of at least 32 characters.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_NAME=ecolith.sid
SESSION_MAX_AGE_MS=86400000

# Set these origins to the exact frontend and backend origins for each environment.
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000

# Create an OAuth 2.0 Web application client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Used only when explicitly running `npm run create-admin`.
DEFAULT_ADMIN_NAME=
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# SMTP credentials are required for password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
